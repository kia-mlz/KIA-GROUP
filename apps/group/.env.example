# Frontend (Next.js) — copy to apps/group/.env.local
# Empty NEXT_PUBLIC_API_URL → same-origin /api proxy (recommended).

NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Stripe publishable key (server secret stays on the API).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Never enable in production / real user environments.
NEXT_PUBLIC_DEMO_MODE=false
