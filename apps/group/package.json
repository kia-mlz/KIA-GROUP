    "@kia./permissions": "workspace:*",
    "@kia./shared": "workspace:*",
    "lucide-react": "^1.38.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
