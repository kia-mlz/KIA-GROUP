DATABASE_URL=postgresql://kia_academy:kia_academy@localhost:5432/kia_academy?schema=public
# Docker full stack: postgresql://kia_academy:kia_academy@postgres:5432/kia_academy?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# REQUIRED — use long random strings in any shared/staging/production environment (min 32 chars).
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-a-different-long-string
JWT_REFRESH_EXPIRES_IN=7d
# Optional: dedicated secret for signed lesson video URLs (defaults to JWT_SECRET)
# JWT_ACCESS_SECRET=

# Return OTP as `devCode` in API responses (development/test only). Ignored/forbidden in production.
# Production OTP delivery is configured in Admin → OTP/SMS (Kavenegar API key + verify template).
OTP_DEV_EXPOSE=true

# Set to true when the API sits behind a reverse proxy (correct client IP + secure cookies).
# TRUST_PROXY=true

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=kia. <noreply@kia.academy>
