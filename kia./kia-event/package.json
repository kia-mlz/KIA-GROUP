    "test": "jest"
  },
  "dependencies": {
    "@kia./platform": "workspace:*",
    "@kia./shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.3"
  }
}
