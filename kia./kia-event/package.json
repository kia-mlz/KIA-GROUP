{
  "name": "@kia./kia-event",
  "version": "1.0.0",
  "private": true,
  "description": "KIA Event — events department package (competitions, challenges, bootcamps). One of the six kia. departments; isolated from the others by lint rule.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"**/*.ts\" --config ../../eslint.config.mjs",
